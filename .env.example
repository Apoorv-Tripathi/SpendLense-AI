# ─── Frontend Environment Variables ─────────────────────────────────────────────
# Optional: defaults to http://localhost:8080/api if unset
VITE_API_URL=http://localhost:8080/api

# ─── Backend Environment Variables (copy to backend/.env) ───────────────────────
PORT=8080
NODE_ENV=development

# ─── Database (Optional) ────────────────────────────────────────────────────────
# If MONGODB_URI is omitted, SpendLens automatically operates in in-memory mode.
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/spendlens?retryWrites=true&w=majority

# ─── AI Executive Summary Providers ────────────────────────────────────────────
# Set at least one to enable live LLM executive summary generation.
# If omitted, SpendLens uses its built-in deterministic heuristic analysis engine.
# Primary: Google Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Secondary: Groq AI (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Transactional Email (Optional) ─────────────────────────────────────────────
# RESEND_API_KEY=your_resend_api_key_here
# RESEND_FROM_EMAIL=SpendLens <hello@yourdomain.com>

# ─── Frontend URL ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_MAX=100
