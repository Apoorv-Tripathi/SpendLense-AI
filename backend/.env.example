# ─── Server Configuration ───────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ─── Database (Optional) ────────────────────────────────────────────────────────
# If MONGODB_URI is omitted, SpendLens automatically falls back to an in-memory store.
# Get free MongoDB Atlas connection string: https://cloud.mongodb.com
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/spendlens?retryWrites=true&w=majority

# ─── AI Provider Configuration (At least one recommended for live LLM) ──────────
# Primary: Google Gemini API (Recommended)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Secondary / Alternative: Groq AI (Fast LLaMA 3.3 inference)
# Get free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Email Delivery (Optional) ──────────────────────────────────────────────────
# Required only if you want transactional lead report emails via Resend
# Get key: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=SpendLens <hello@yourdomain.com>

# ─── Frontend Integration & CORS ────────────────────────────────────────────────
# URL where your Vite React frontend is running
FRONTEND_URL=http://localhost:5173

# ─── Security & Rate Limiting ───────────────────────────────────────────────────
RATE_LIMIT_MAX=100
